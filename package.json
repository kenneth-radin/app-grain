{
  "name": "grain-fe",
  "version": "1.0.0",
  "description": "grAIn - Farmer-facing Expo mobile app for IoT Smart Grain Dryer",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "eslint . --ext .tsx,.ts",
    "type-check": "tsc --noEmit",
    "eas:build:ios": "eas build --platform ios",
    "eas:build:android": "eas build --platform android",
    "eas:build:all": "eas build --platform all",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(expo|@expo|react-native|@react-native|@react-navigation|firebase|axios)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterSetup": [],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@types/react": "~19.1.10",
    "axios": "^1.15.1",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.12.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "json5": "^2.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@testing-library/react-native": "^12.9.0",
    "babel-preset-expo": "^55.0.19",
    "core-js-compat": "^3.49.0",
    "eslint": "^8.51.0",
    "expo-module-scripts": "^55.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "^5.2.2"
  },
  "private": true
}
